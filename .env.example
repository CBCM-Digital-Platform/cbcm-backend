# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cbcm
DB_USER=cbcm_user
DB_PASSWORD=your_db_password
DB_DIALECT=postgres

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Storage Provider (local or s3)
STORAGE_PROVIDER=local

# AWS S3 Configuration (required if STORAGE_PROVIDER=s3)
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_KEY_PREFIX=cbcm-resources

# File Upload
UPLOAD_MAX_BYTES=52428800

# Server
PORT=5000
NODE_ENV=development

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@cbcm.org

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Assistant (Google Gemini)
# Get a key at https://aistudio.google.com/apikey — server-side only, never expose to frontends.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.3
AI_MAX_RETRIEVED_CHUNKS=5
AI_REQUEST_TIMEOUT=60000
AI_MAX_RETRIES=2
# Privacy gate: must remain false until organizational privacy/legal approval.
# When false, mentee/mentor profile and assessment data are never sent to Gemini.
AI_SEND_USER_CONTEXT=false
