NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE

JWT_ACCESS_SECRET=aa8d9c43adf709b63ddbf1338115736da151a005c53a27245a28325960c7df06
JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Brevo transactional email delivery (HTTPS API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=CBCM

# Optional HTTPS email delivery for Render Free; overrides SMTP when configured.
RESEND_API_KEY=
EMAIL_FROM=CBCM <no-reply@example.com>

# Development-only public Jitsi mode (disabled in production)

JITSI_PUBLIC_MODE=true
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_SECRET=
JITSI_TOKEN_EXPIRY=1h
