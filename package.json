{
  "name": "cbcm-backend",
  "version": "1.0.0",
  "main": ".eslintrc.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/unit/messaging.test.js tests/unit/learning.test.js tests/unit/sessions.test.js tests/unit/storage.test.js tests/unit/upload.test.js tests/unit/uploads-api.test.js tests/unit/resources.test.js",
    "test:swagger": "node --test tests/unit/swagger.test.js",
    "test:learning": "node --test tests/unit/learning.test.js",
    "test:messaging": "node --test tests/unit/messaging.test.js",
    "test:sessions": "node --test tests/unit/sessions.test.js",
    "test:storage": "node --test tests/unit/storage.test.js",
    "test:upload": "node --test tests/unit/upload.test.js tests/unit/uploads-api.test.js",
    "test:models": "node scripts/test-models.js",
    "verify:models": "node scripts/verify-models-db.js",
    "seed": "node scripts/seed.js",
    "seed:production": "node scripts/seed-production.js",
    "migrate": "node node_modules/sequelize-cli/lib/sequelize db:migrate",
    "migrate:production": "node node_modules/sequelize-cli/lib/sequelize db:migrate --env production",
    "migrate:undo": "node node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "test:resources": "node --test tests/unit/resources.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "sqlite3": "^6.0.1"
  }
}
